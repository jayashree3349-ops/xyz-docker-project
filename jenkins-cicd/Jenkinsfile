pipeline {
    agent any

    environment {
        IMAGE_NAME = 'jayashree0009/xyz-cicd-app'
        STACK_NAME = 'xyz-cicd'
    }

    stages {
        stage('Test') {
            steps {
                dir('jenkins-cicd/app') {
                    sh 'python3 -m unittest -v test_app.py'
                }
            }
        }

        stage('Build image') {
            steps {
                sh 'docker build -t ${IMAGE_NAME}:${BUILD_NUMBER} jenkins-cicd/app'
            }
        }

        stage('Push image') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'DOCKERHUB_USER',
                    passwordVariable: 'DOCKERHUB_TOKEN'
                )]) {
                    sh '''
                        set +x
                        echo "$DOCKERHUB_TOKEN" | docker login \
                          -u "$DOCKERHUB_USER" --password-stdin
                        docker push "${IMAGE_NAME}:${BUILD_NUMBER}"
                    '''
                }
            }
        }

        stage('Deploy to Swarm') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'DOCKERHUB_USER',
                    passwordVariable: 'DOCKERHUB_TOKEN'
                )]) {
                    sh '''
                        set +x
                        echo "$DOCKERHUB_TOKEN" | docker login \
                          -u "$DOCKERHUB_USER" --password-stdin
                        export IMAGE_TAG="${BUILD_NUMBER}"
                        docker stack deploy \
                          --with-registry-auth \
                          -c jenkins-cicd/deploy-compose.yml "$STACK_NAME"
                    '''
                }
            }
        }

        stage('Verify deployment') {
            steps {
                sh '''
                    docker service ls
                    docker stack services "$STACK_NAME"
                    for attempt in $(seq 1 15); do
                        if curl --fail --silent http://127.0.0.1:8082/; then
                            exit 0
                        fi
                        echo "Waiting for application (attempt $attempt/15)..."
                        sleep 2
                    done
                    echo "Application verification failed"
                    exit 1
                '''
            }
        }
    }

    post {
        always {
            sh 'docker logout || true'
        }
    }
}
